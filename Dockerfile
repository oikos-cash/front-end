# Production image for apps/app (Next.js) — built and run by Dokploy.
# NEXT_PUBLIC_* values are inlined at build time, so they come in as build args.

FROM node:20-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@10.8.1
WORKDIR /repo

FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_VAULT_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_WEBCONTAINER_BACKEND
ARG NEXT_PUBLIC_WEBCONTAINER_WS_URL
ARG NEXT_PUBLIC_WEBCONTAINER_HOST_TUNNEL
ARG BUILD_MAX_OLD_SPACE=6144
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_VAULT_API_URL=$NEXT_PUBLIC_VAULT_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID \
    NEXT_PUBLIC_WEBCONTAINER_BACKEND=$NEXT_PUBLIC_WEBCONTAINER_BACKEND \
    NEXT_PUBLIC_WEBCONTAINER_WS_URL=$NEXT_PUBLIC_WEBCONTAINER_WS_URL \
    NEXT_PUBLIC_WEBCONTAINER_HOST_TUNNEL=$NEXT_PUBLIC_WEBCONTAINER_HOST_TUNNEL

WORKDIR /repo/apps/app
RUN NODE_OPTIONS="--max-old-space-size=$BUILD_MAX_OLD_SPACE" ./node_modules/.bin/next build

FROM base AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /repo /repo
RUN rm -rf /repo/apps/app/.next/cache
WORKDIR /repo/apps/app
EXPOSE 3000
CMD ["sh", "-c", "NODE_OPTIONS='--max-old-space-size=2048' ./node_modules/.bin/next start -H 0.0.0.0 -p ${PORT:-3000}"]
